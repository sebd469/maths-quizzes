    },
    {
      "id": "3iec-standard-indices-q08",
      "section": "Standard form — Challenge",
      "title": "8",
      "prompt": "Simplify \\(2.4\\times10^n+6\\times10^{n-1}\\) for any integer \\(n\\). Give your answer in standard form.",
