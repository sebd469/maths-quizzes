{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mr-d-quiz-results",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [{ "binding": "DB", "database_name": "mr-d-quiz-results", "database_id": "REPLACE_WITH_CREATED_DATABASE_ID", "jurisdiction": "eu" }],
  "ratelimits": [{ "name": "SUBMISSION_LIMITER", "namespace_id": "46901", "simple": { "limit": 120, "period": 60 } }],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": { "ALLOWED_ORIGINS": "https://www.mr-d-maths.com,https://mr-d-maths.com" },
  // After onboarding a sending domain and verifying the teacher destination:
  // "send_email": [{ "name": "EMAIL" }],
  // Set ADMIN_TOKEN, TURNSTILE_SECRET, NOTIFY_TO, NOTIFY_FROM as Worker secrets.
  // Email addresses must never be stored in public site files.
}
